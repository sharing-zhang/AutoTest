{
  "check_Reward": {
    "dialog_title": "检查奖励配置",
    "parameters": [
      {
        "name": "directory",
        "type": "text",
        "label": "目录路径",
        "required": true,
        "default": "C:\\temp",
        "placeholder": "例如: C:\\\\temp",
        "help": "输入要检查的文件路径"
      },
      {
        "name": "file_name",
        "type": "text",
        "label": "配置文件名",
        "required": true,
        "default": "REWARD.txt",
        "placeholder": "例如：REWARD.txt",
        "help": "输入要检查的文件名，仅支持单个文件名"
      },
      {
        "name": "block_name",
        "type": "text",
        "label": "配置块名称",
        "required": true,
        "default": "progressRewards",
        "help": "输入奖励检查的配置块名称，例如：Rewards"
      },
      {
        "name": "rules",
        "type": "group-list",
        "label": "配置项组",
        "required": true,
        "help": "包含：奖励ID、数量ID、最大奖励值",
        "item_fields": [
          { "name": "reward_id", "type": "text", "label": "reward_id", "placeholder": "奖励ID，支持正则或精确值" },
          { "name": "count_id", "type": "text", "label": "count_id", "placeholder": "数量ID" },
          { "name": "max_reward", "type": "number", "label": "max_reward", "min": 0 , "addonAfter": "最大奖励值" }
        ]
      }
    ]
  },
  "check_ConfigTime": {
    "dialog_title": "检查配置时间合法性",
    "parameters": [
      {
        "name": "directory",
        "type": "text",
        "label": "目录路径",
        "required": true,
        "default": "D:\\",
        "placeholder": "例如: C:\\temp 或 /home/user/documents",
        "help": "输入要检查的文件名所在目录"
      },
      {
        "name": "file_names",
        "type": "tags",
        "label": "配置文件名",
        "required": false,
        "multiple": true,
        "default": [
          "TIMER_MAIN.data.txt"
        ],
        "placeholder": "例如：TIMER_MAIN.data.txt",
        "help": "输入要检查的文件名"
      },
      {
        "name": "start_time_field",
        "type": "text",
        "label": "开始时间对应字段名",
        "required": true,
        "default": "openTime",
        "help": "输入配置中开始时间字段的名称"
      },
      {
        "name": "end_time_field",
        "type": "text",
        "label": "结束时间对应参数",
        "required": true,
        "default": "endTime",
        "help": "输入配置中结束时间字段的名称"
      },
      {
        "name": "recursive",
        "type": "switch",
        "label": "递归扫描子目录",
        "required": false,
        "default": false
      },
      {
        "name": "encoding",
        "type": "select",
        "label": "文件编码",
        "options": [
          "UTF-16",
          "UTF-8",
          "GBK",
          "ASCII"
        ],
        "required": false,
        "default": "UTF-16"
      },
      {
        "name": "expected_days",
        "type": "tags",
        "label": "正确的活动天数",
        "required": false,
        "multiple": true,
        "default": [
          3,
          7,
          14
        ],
        "placeholder": "例如：3, 7, 14",
        "help": "输入正确的活动天数，支持输入多个"
      }
    ]
  },

  "checkConfigExist": {
    "dialog_title": "检查配置路径存在性",
    "parameters": [
      {
        "name": "config_file",
        "type": "text",
        "label": "配置文件地址",
        "required": true,
        "default": "D:\\fish_test\\FISH.data11.txt",
        "placeholder": "例如D:\\TimeConfig\\FISH.data.txt",
        "help": "所需检查的配置文件地址"
      },
      {
        "name": "project_root",
        "type": "text",
        "label": "工程文件目录",
        "required": true,
        "default": "E:\\Dev_2024_3_30\\client\\MainProject\\Assets\\InBundle",
        "placeholder": "例如：D:\\dev\\client\\MainProject\\Assets",
        "help": "输入工程文件的目录"
      },
      {
        "name": "path_fields_param",
        "type": "text",
        "label": "配置字段名",
        "required": true,
        "default": "assetName",
        "placeholder": "例如：assetName，仅支持输入一个",
        "help": "输入想要查找的配置字段名称"
      },
      {
        "name": "custom_extensions_param",
        "type": "checkbox",
        "label": "文件后缀名",
        "options": [
        ".anim", ".asset", ".bytes", ".controller", ".dae", ".dds",
        ".fbx", ".font", ".hlsl", ".jpg", ".json", ".mat", ".mp3",
        ".obj", ".png", ".prefab",".scene", ".shader", ".tga", ".ttf",
        ".txt", ".unity", ".wav", ".xml"
        ],
        "required": false,
        "multiple": true,
        "default": [".txt"],
        "placeholder": "请选择文件名后缀",
        "help": "选择要检查的工程文件后缀类型，可多选"
      }
    ]
  },

  "checkFileName": {
    "dialog_title": "检查文件名合法性",
    "parameters": [
      {
        "name": "root_path",
        "type": "text",
        "label": "目录路径",
        "required": true,
        "default": "D:\\dev",
        "placeholder": "例如: D:\\dev",
        "help": "输入要检查的文件所在目录"
      },
      {
        "name": "regex_pattern",
        "type": "text",
        "label": "正则表达式",
        "required": true,
        "default": "^[a-zA-Z0-9_]+\\.[a-z]+$",
        "placeholder": "例如：^[a-zA-Z0-9_]+\\.[a-z]+$ ",
        "help": "输入正确文件名的正则表达式"
      },
      {
        "name": "file_extensions",
        "type": "checkbox",
        "label": "文件后缀名",
        "options": [
          ".anim", ".asmdef", ".bat", ".c", ".cmake",
          ".controller", ".cs", ".dll", ".exe", ".exr",
          ".FBX", ".gif", ".h", ".java", ".jpg",
          ".json", ".log", ".lua", ".mat", ".md",
          ".meta", ".mp3", ".mp4", ".pdb", ".pdf",
          ".png", ".prefab", ".psd", ".py", ".shader",
          ".svg", ".tga", ".txt", ".unity", ".xlsx",
          ".xml"
        ],
        "required": false,
        "multiple": true,
        "default": [".txt"],
        "placeholder": "请选择文件后缀名",
        "help": "选择要检查的文件后缀类型，可多选"
      }
    ]
  },
  "checkconfigempty": {
    "dialog_title": "检查配置不为空",
    "parameters": [
      {
        "name": "file_path",
        "type": "text",
        "label": "配置文件地址",
        "required": true,
        "default": "D:\\TimeConfig\\FISH.data.txt",
        "placeholder": "例如D:\\TimeConfig\\FISH.data.txt",
        "help": "输入配置文件文件地址"
      },
      {
        "name": "parameters_str",
        "type": "text",
        "label": "配置字段名",
        "required": true,
        "default": "id",
        "placeholder": "例如：id,name,tpId",
        "help ": "输入配置字段名称，支持多个值"
      }
    ]
  },
  "checkconfigunique": {
    "dialog_title": "配置字段唯一性检查",
    "parameters": [
      {
        "name": "file_path",
        "type": "text",
        "label": "配置文件地址",
        "required": true,
        "default": "D:\\TimeConfig\\FISH.data.txt",
        "placeholder": "例如D:\\TimeConfig\\config.data.txt",
        "help": "输入配置文件的地址"
      },
      {
        "name": "parameters_str",
        "type": "text",
        "label": "配置参数名",
        "required": true,
        "default": "id",
        "placeholder": "例如：id,name,tpId",
        "help": "输入配置字段名称，支持多个值"
      }
    ]
  },
  "check_TranslateQuality": {
    "dialog_title": "文本翻译质量检查",
    "parameters": [
      {
        "name": "input_mode",
        "type": "radio",
        "label": "输入模式",
        "required": true,
        "default": "dual_file",
        "options": [
          {"value": "dual_file", "label": "双文件模式"},
          {"value": "single_file", "label": "单文件双字段模式"}
        ],
        "help": "选择输入方式：双文件模式适合中文和外文配置分别在不同文件的情况；单文件模式适合中外文配置在同一文件不同字段的情况"
      },
      {
        "name": "directory1",
        "type": "text",
        "label": "中文配置表所在路径",
        "required": true,
        "default": "D:\\",
        "placeholder": "例如: C:\\temp 或 /home/user/docs",
        "help": "需要检查的中文配置表所在路径",
        "show_when": "input_mode === 'dual_file'"
      },
      {
        "name": "file_name1",
        "type": "text",
        "label": "中文配置表文件名",
        "required": true,
        "default": "CH.txt",
        "help": "需要检查的中文配置表文件名",
        "show_when": "input_mode === 'dual_file'"
      },
      {
        "name": "directory2",
        "type": "text",
        "label": "外文配置表所在路径",
        "required": true,
        "default": "D:\\",
        "placeholder": "例如: C:\\temp 或 /home/user/docs",
        "help": "需要检查的外文配置表所在路径",
        "show_when": "input_mode === 'dual_file'"
      },
      {
        "name": "file_name2",
        "type": "text",
        "label": "外文配置表文件名",
        "required": true,
        "default": "Eng.txt",
        "help": "需要检查的外文配置表文件名",
        "show_when": "input_mode === 'dual_file'"
      },
      {
        "name": "field",
        "type": "text",
        "label": "字段名",
        "required": true,
        "default": "t_mailcontent",
        "placeholder": "如从 key=\"value\"; 中抽取某字段值，例如 desc",
        "help": "指定要检查翻译质量的字段名（双文件模式：两个文件使用相同字段名）",
        "show_when": "input_mode === 'dual_file'"
      },
      {
        "name": "single_directory",
        "type": "text",
        "label": "配置表路径",
        "required": true,
        "default": "D:\\",
        "placeholder": "例如: C:\\temp 或 /home/user/docs",
        "help": "包含中英文字段的文件的目录路径",
        "show_when": "input_mode === 'single_file'"
      },
      {
        "name": "single_file_name",
        "type": "text",
        "label": "配置表名",
        "required": true,
        "default": "config.txt",
        "placeholder": "多语言文本配置表",
        "show_when": "input_mode === 'single_file'"
      },
      {
        "name": "chinese_field",
        "type": "text",
        "label": "中文字段名",
        "required": true,
        "default": "chinese_text",
        "placeholder": "如从 key=\"value\"; 中抽取中文字段值，例如 desc_cn",
        "help": "指定包含中文文本的字段名",
        "show_when": "input_mode === 'single_file'"
      },
      {
        "name": "foreign_field",
        "type": "text",
        "label": "外文字段名",
        "required": true,
        "default": "english_text",
        "placeholder": "如从 key=\"value\"; 中抽取外文字段值，例如 desc_en",
        "help": "指定包含外文文本的字段名",
        "show_when": "input_mode === 'single_file'"
      },
      {
        "name": "language_check",
        "type": "select",
        "label": "翻译语言类型",
        "required": true,
        "default": "中英翻译检查",
        "options": [
          "中英翻译检查",
          "中日翻译检查",
          "中韩翻译检查"
        ],
        "help": "选择要进行的翻译质量检查类型"
      }
    ]
  },
  "check_TextQuality": {
    "dialog_title": "文本质量检查",
    "parameters": [
      {
        "name": "directory",
        "type": "text",
        "label": "目录路径",
        "required": true,
        "default": "D:\\",
        "placeholder": "例如: C:\\temp 或 /home/user/docs",
        "help": "输入所检查文件所在目录路径"
      },
      {
        "name": "file_name",
        "type": "text",
        "label": "文件名",
        "required": true,
        "default": "readme.txt",
        "placeholder": "需要检查的单个文件名，仅支持一个",
        "help": "输入所检查文件名"
      },
      {
        "name": "field",
        "type": "text",
        "label": "字段名(可选)",
        "required": false,
        "placeholder": "如从 key=\"value\"; 中抽取某字段值，例如 desc",
        "help": "输入所检查的配置文本的字段名，不填则按行依次检查"
      }
    ]
  },

  "find_resource_name": {
    "dialog_title": "文件内容搜索",
    "parameters": [
      {
        "name": "search_string",
        "type": "text",
        "label": "搜索字符串",
        "required": true,
        "placeholder": "输入要在文件内容中搜索的字符串"
      },
      {
        "name": "target_files",
        "type": "tags",
        "label": "目标文件/目录",
        "required": true,
        "multiple": true,
        "default":"F:\\fish_test",
        "placeholder": "输入要搜索的文件或目录路径，按回车添加"
      },
      {
        "name": "file_formats",
        "type": "checkbox",
        "label": "文件格式",
        "options": [
          ".txt", ".cs", ".py", ".js", ".ts", ".json", ".xml", ".cfg", ".ini", ".conf"
        ],
        "required": false,
        "multiple": true,
        "default": [".txt", ".json"]
      },
      {
        "name": "match_rules",
        "type": "checkbox",
        "label": "匹配规则",
        "options": [
          "全匹配",
          "前缀匹配",
          "后缀匹配",
          "包含匹配"
        ],
        "required": false,
        "multiple": true,
        "default": ["包含匹配"]
      }
    ]
  },
  "backupAssetsMD5": {
    "dialog_title": "文件增删改备份",
    "parameters": [
      {
        "name": "root_path",
        "type": "select",
        "label": "文件路径",
        "required": true,
        "options_source": "/myapp/admin/scanDevUpdate/backupPathOptions",
        "placeholder": "请选择要备份的文件路径"
      },
      {
        "name": "backup_dir",
        "type": "text",
        "label": "备份目录",
        "required": true,
        "default": "../upload/databackup",
        "placeholder": "输入备份文件保存目录",
        "help": "备份文件将保存到此目录"
      }
    ]
  },
  "compareAssetsUpdate": {
    "dialog_title": "文件增删改对比",
    "parameters": [
      {
        "name": "root_path",
        "type": "select",
        "label": "文件路径",
        "required": true,
        "options_source": "/myapp/admin/scanDevUpdate/backupPathOptions",
        "placeholder": "请选择文件路径"
      },
      {
        "name": "backup_file_name",
        "type": "select",
        "label": "备份文件名",
        "required": true,
        "options_source": "/myapp/admin/scanDevUpdate/backupFileNameOptions",
        "placeholder": "请选择备份文件名"
      }
    ]
  }
}